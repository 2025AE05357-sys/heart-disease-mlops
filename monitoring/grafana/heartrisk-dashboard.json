    {
      "id": 11,
      "type": "heatmap",
      "title": "Predicted probability distribution",
      "description": "Predictions per probability bucket over time (upper bucket edge on the y axis).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(heartrisk_prediction_probability_bucket{le!=\"+Inf\"}[1m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "range": true,
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "none"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Purples",
          "fill": "dark-purple",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false
        },
        "cellGap": 2,
        "tooltip": {
          "mode": "single",
          "yHistogram": false
        },
        "legend": {
          "show": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
